    {
      "name": "4. Membership & Dynamic LKR Pricing",
      "item": [
        {
          "name": "Calculate Price (Base 2500 LKR)",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:8080/api/memberships/calculate?hasTrainer=false&hasTreadmill=false", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "memberships", "calculate"], "query": [{ "key": "hasTrainer", "value": "false" }, { "key": "hasTreadmill", "value": "false" }] }
          }
        },
        {
          "name": "Calculate Price (Trainer Addon = 4500 LKR)",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:8080/api/memberships/calculate?hasTrainer=true&hasTreadmill=false", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "memberships", "calculate"], "query": [{ "key": "hasTrainer", "value": "true" }, { "key": "hasTreadmill", "value": "false" }] }
          }
        },
        {
          "name": "Calculate Price (Trainer + Treadmill = 5500 LKR)",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:8080/api/memberships/calculate?hasTrainer=true&hasTreadmill=true", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "memberships", "calculate"], "query": [{ "key": "hasTrainer", "value": "true" }, { "key": "hasTreadmill", "value": "true" }] }
          }
        },
        {
          "name": "Subscribe Membership (Customer 5)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 5,\n  \"trainerId\": 1,\n  \"hasTrainer\": true,\n  \"hasTreadmill\": true\n}"
            },
            "url": { "raw": "http://localhost:8080/api/memberships", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "memberships"] }
          }
        },
        {
          "name": "Get Customer Active Membership",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/memberships/customer/5", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "memberships", "customer", "5"] }
          }
        }
      ]
