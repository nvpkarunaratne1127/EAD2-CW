        {
          "name": "Create Supplement (Whey Protein)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NitroTech 100% Whey Gold\",\n  \"category\": \"WHEY_PROTEIN\",\n  \"brand\": \"MuscleTech\",\n  \"priceLkr\": 27500.00,\n  \"stockQuantity\": 12,\n  \"servingSize\": \"5.5 lbs / 2.5kg (76 servings)\",\n  \"description\": \"Micro-filtered whey peptides and isolate\"\n}"
