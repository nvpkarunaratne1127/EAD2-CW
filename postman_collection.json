    {
      "name": "2. Equipment Resource (CRUD)",
      "item": [
        {
          "name": "Get All Equipment",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/equipment", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "equipment"] }
          }
        },
        {
          "name": "Get Equipment by Category (Dumbbells)",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/equipment?category=DUMBBELL", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "equipment"], "query": [{ "key": "category", "value": "DUMBBELL" }] }
          }
        },
        {
          "name": "Create Equipment (Machine)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Seated Calf Raise Machine\",\n  \"category\": \"MACHINE\",\n  \"quantity\": 2,\n  \"weightSpecs\": \"Plate-loaded Olympic peg\",\n  \"status\": \"AVAILABLE\",\n  \"description\": \"Soleus isolation calf machine with adjustable knee pads\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/equipment", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "equipment"] }
          }
        },
        {
          "name": "Update Equipment",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hex Rubber Dumbbells Rack (Pairs)\",\n  \"category\": \"DUMBBELL\",\n  \"quantity\": 30,\n  \"weightSpecs\": \"Pairs from 2.5kg to 40kg\",\n  \"status\": \"AVAILABLE\",\n  \"description\": \"Updated with additional heavy dumbbell pairs\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/equipment/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "equipment", "1"] }
          }
        },
        {
          "name": "Delete Equipment",
          "request": {
            "method": "DELETE",
            "url": { "raw": "http://localhost:8080/api/equipment/16", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "equipment", "16"] }
          }
        }
      ]
    },
    {
